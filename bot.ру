import os
import threading
import telebot
from flask import Flask

# --- Telegram Bot ---
TOKEN = os.environ.get('BOT_TOKEN')
bot = telebot.TeleBot(TOKEN)

@bot.message_handler(commands=['start'])
def start(message):
    bot.send_message(message.chat.id, "Привет! Я бот для ПБ арен. Используй команды:\n"
                                      "/vote — оставить мнение\n"
                                      "/opinions — посмотреть мнения других\n"
                                      "/stats — статистика\n"
                                      "/updates — новые арены")

@bot.message_handler(commands=['vote'])
def vote(message):
    bot.send_message(message.chat.id, "Напиши своё мнение по ПБ арене, и я его сохраню.")

@bot.message_handler(commands=['opinions'])
def opinions(message):
    bot.send_message(message.chat.id, "Здесь будут отображаться мнения других участников (пока в разработке).")

@bot.message_handler(commands=['stats'])
def stats(message):
    bot.send_message(message.chat.id, "Статистика по аренам (пока в разработке).")

@bot.message_handler(commands=['updates'])
def updates(message):
    bot.send_message(message.chat.id, "Новые арены (пока в разработке).")

@bot.message_handler(func=lambda message: True)
def echo(message):
    bot.send_message(message.chat.id, "Я получил твоё сообщение: " + message.text)

def run_bot():
    print("Бот запущен...")
    bot.polling(none_stop=True)

# --- Flask (для Render) ---
app = Flask(__name__)

@app.route('/')
def index():
    return "Бот работает!"

if __name__ == '__main__':
    # Запускаем бота в отдельном потоке
    threading.Thread(target=run_bot, daemon=True).start()
    # Запускаем Flask-сервер (Render даст ему порт)
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port)
